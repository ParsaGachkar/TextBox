@inherits LayoutComponentBase

<div class="min-h-screen bg-base-200 flex flex-col">
    <div class="navbar bg-base-100 shadow-sm px-4">
        <div class="flex-1">
            <a href="" class="btn btn-ghost text-xl">TextBox</a>
        </div>
        <div class="flex-none flex items-center gap-1">
            <ThemeToggle />
            <a href="scalar" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">API docs</a>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row justify-center items-center lg:items-start gap-8 px-4 py-6 grow">
        <div class="mockup-phone">
            <div class="mockup-phone-camera"></div>
            <div class="mockup-phone-display bg-base-100 text-base-content flex flex-col relative pt-[15%]">
                @Body
            </div>
        </div>
        <div class="divider lg:divider-horizontal"></div>
        <HomeAside />
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
