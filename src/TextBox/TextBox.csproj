<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="LiteDB.Async" Version="0.1.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TextBox.Tests" />
  </ItemGroup>

  <!-- Tailwind CSS v4 + daisyUI: compile Styles/app.css into wwwroot/css/app.css.
       Invokes node directly on the CLI entry point (no npx/shim - behaves
       identically on Windows dev machines and Linux containers).
       Run `npm run watch:css` in src/TextBox during development for live rebuilds. -->
  <Target Name="BuildTailwindCss" BeforeTargets="Build">
    <Exec Command="node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./Styles/app.css -o ./wwwroot/css/app.css --minify" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
